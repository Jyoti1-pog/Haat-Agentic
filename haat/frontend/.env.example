# Supabase — get from Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API base URL
# Local dev: leave empty (Vite proxy handles /api → localhost:3001)
# Production: set to your Render backend URL (e.g. https://haat-backend.onrender.com)
VITE_API_URL=

# Storefront search in local dev defaults to the bundled mock catalogue and
# never calls the backend. Set this to "false" to make `npm run dev` use the
# real API — needed to see digital products and the Digital filter locally.
# Production builds always use the real backend regardless of this setting.
# The /agent-checkout surface is unaffected: it always calls the real backend.
VITE_FRONTEND_ONLY=false
