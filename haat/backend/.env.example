# ── The AI buyer ─────────────────────────────────────────────────────────────
# Set ONE of these. OpenAI wins if both are present; LLM_PROVIDER forces either.
# With neither, the tools, guardrails and ledger still run — only the
# natural-language buyer is unavailable, and the scripted demo drives the rest.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6

ELEVENLABS_API_KEY=
TINYFISH_API_KEY=
PORT=3001

# Supabase — get from Supabase dashboard → Project Settings → API
SUPABASE_JWT_SECRET=

# CORS — set to your Netlify URL in production (e.g. https://haat.netlify.app)
FRONTEND_URL=http://localhost:3000

# ── Agentic commerce (digital products) ──────────────────────────────────────
# Razorpay test keys — Dashboard → Settings → API Keys → Generate Test Key.
# Without these the order flow still runs end to end, but order ids are minted
# locally and every response and audit row is stamped "unconfigured" so nothing
# can be mistaken for a real Razorpay object.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Only needed if you point Razorpay webhooks at /api/agent-commerce/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ── REQUIRED IN PRODUCTION ───────────────────────────────────────────────────
# Signs the time-limited download links, and (when Razorpay keys are absent) the
# stand-in payment signatures. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Without it each process invents its own secret. That is survivable on one
# long-lived server and fatal on a multi-instance or serverless host: the
# instance that signs a payment is not the one that verifies it, so every
# payment fails and every download link 403s.
DIGITAL_SIGNING_SECRET=
DIGITAL_URL_TTL_HOURS=48

# Absolute origin used to build download links (e.g. https://haat-backend.onrender.com).
# Leave empty for local dev — links come back as relative paths through the proxy.
PUBLIC_BASE_URL=

# Agent spend caps, in paise. Defaults: ₹2,000 per transaction, ₹7,000 per session.
# Keep the session ceiling comfortably above the priciest SKU, or an over-cap
# item gets blocked by the session budget before the approval gate can run.
# ── Shared state ─────────────────────────────────────────────────────────────
# Locally the store is a JSON file on disk. Serverless has no persistent local
# disk and no shared memory, so a purchase — which is three separate requests —
# cannot complete without a shared store. Upstash Redis over REST works from a
# serverless function because it is HTTP rather than a pooled TCP connection.
# Vercel's own KV_REST_API_* variables are read too, if you use that instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Agent identity ───────────────────────────────────────────────────────────
# Comma-separated keys, each optionally `key:label` where the label shows up in
# the audit trail. When set, agent endpoints require a key AND every session is
# namespaced to it, so two agents cannot collide or spend each other's budget
# even if they pick the same session name.
#
# Leave empty and the surface is open — right for local dev and for a demo
# anyone should be able to try, wrong once real money is involved.
# /api/health reports which mode is live.
HAAT_API_KEYS=

# How long a write may wait for the store lock before the request is refused
# with a retryable 503. It is refused rather than allowed through unlocked,
# because proceeding is how concurrent writes get silently lost.
HAAT_LOCK_WAIT_MS=8000
HAAT_LOCK_TTL_MS=10000

AGENT_TXN_CAP_PAISE=200000
AGENT_SESSION_CAP_PAISE=700000
INR_PER_USD=83.5
