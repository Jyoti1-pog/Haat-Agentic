# ── The AI buyer ─────────────────────────────────────────────────────────────
# Set ONE of these. OpenAI wins if both are present; LLM_PROVIDER forces either.
# With neither, the tools, guardrails and ledger still run — only the
# natural-language buyer is unavailable, and the scripted demo drives the rest.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6

ELEVENLABS_API_KEY=
TINYFISH_API_KEY=
PORT=3001

# Supabase — get from Supabase dashboard → Project Settings → API
SUPABASE_JWT_SECRET=

# CORS — set to your Netlify URL in production (e.g. https://haat.netlify.app)
FRONTEND_URL=http://localhost:3000

# ── Agentic commerce (digital products) ──────────────────────────────────────
# Razorpay test keys — Dashboard → Settings → API Keys → Generate Test Key.
# Without these the order flow still runs end to end, but order ids are minted
# locally and every response and audit row is stamped "unconfigured" so nothing
# can be mistaken for a real Razorpay object.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Only needed if you point Razorpay webhooks at /api/agent-commerce/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Signs the time-limited download links. Any long random string; without it,
# links are still signed but stop working when the process restarts.
DIGITAL_SIGNING_SECRET=
DIGITAL_URL_TTL_HOURS=48

# Absolute origin used to build download links (e.g. https://haat-backend.onrender.com).
# Leave empty for local dev — links come back as relative paths through the proxy.
PUBLIC_BASE_URL=

# Agent spend caps, in paise. Defaults: ₹2,000 per transaction, ₹7,000 per session.
# Keep the session ceiling comfortably above the priciest SKU, or an over-cap
# item gets blocked by the session budget before the approval gate can run.
AGENT_TXN_CAP_PAISE=200000
AGENT_SESSION_CAP_PAISE=700000
INR_PER_USD=83.5
